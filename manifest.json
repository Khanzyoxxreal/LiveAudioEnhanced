{
  "manifest_version": 3,
  "name": "Live Audio Enhanced",
  "version": "1.0.0",
  "description": "Real-time, fully local DSP audio enhancer for any web page with sound: YouTube, TikTok, Instagram, Facebook and more. No AI, no servers.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Live Audio Enhanced",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
